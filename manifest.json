{
  "manifest_version": 3,
  "name": "Telegram Media Downloader",
  "version": "1.0.2",
  "description": "Unhide download button in Telegram Web media viewer",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web.telegram.org/*",
        "https://webk.telegram.org/*",
        "https://webz.telegram.org/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://web.telegram.org/*",
    "https://webk.telegram.org/*",
    "https://webz.telegram.org/*"
  ]
}
